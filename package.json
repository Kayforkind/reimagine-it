{
  "name": "reimagine-it",
  "version": "2.9.0",
  "description": "Content-Derived Design CLI and agent skill. Reads existing HTML and writes a stronger standalone page from the nouns, dates, numbers, and colors already in the file.",
  "license": "MIT",
  "author": "Kayforkind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayforkind/reimagine-it.git"
  },
  "homepage": "https://kayforkind.github.io/reimagine-it/",
  "keywords": [
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "gemini-cli",
    "design",
    "frontend",
    "content-derived-design",
    "infographic",
    "svg",
    "threejs",
    "simulation",
    "redesign",
    "html",
    "css",
    "cli",
    "command-line",
    "npx",
    "mcp",
    "model-context-protocol"
  ],
  "scripts": {
    "audit": "python scripts/audit_all.py",
    "audit:verbose": "python scripts/audit.py gold/webpage/after.html --verbose",
    "regenerate": "python gold/regenerate_all.py",
    "regenerate:dry": "python gold/regenerate_all.py --dry",
    "regenerate:no-screenshots": "python gold/regenerate_all.py --skip-screenshots",
    "test": "node scripts/test.js",
    "lint:gold": "python scripts/audit_all.py",
    "cli": "node bin/reimagine-it.js",
    "cli:help": "node bin/reimagine-it.js --help",
    "cli:example": "node bin/reimagine-it.js -i gold/webpage/before.html -t webpage -d",
    "test:unit": "node test/unit/cli.test.js",
    "test:mcp": "node test/unit/mcp.test.js",
    "test:e2e": "node test/e2e/cli.e2e.test.js",
    "prepublishOnly": "node scripts/test.js",
    "mcp": "node mcp/server.js",
    "auto": "node scripts/auto.js",
    "build:docs": "node scripts/build-docs-engine.js",
    "check:docs": "node scripts/build-docs-engine.js --check",
    "sync:pages-assets": "python scripts/sync-pages-assets.py",
    "examples": "python examples/end-users/build.py && python scripts/render-example-shots.py && python scripts/sync-case-docs.py && python scripts/build-og.py && npm run sync:pages-assets",
    "examples:tokens": "python scripts/build-token-board.py",
    "examples:social": "python scripts/build-og.py"
  },
  "files": [
    "skills/reimagine-it/",
    "commands/reimagine-it.md",
    "prompts/reimagine-it.md",
    "AGENTS.md",
    "bin/",
    "src/",
    "scripts/audit.py",
    "scripts/audit_all.py",
    "scripts/auto.js",
    "src/auto.js",
    "dsh/README.md",
    "dsh/auto.mjs",
    "dsh/cordis.patch.yml",
    "mcp/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "bin": {
    "reimagine-it": "bin/reimagine-it.js",
    "reimagine-it-mcp": "mcp/server.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
